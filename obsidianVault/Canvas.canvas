			"height":60
		},
		{"id":"bba6ec62b520a2c5","type":"text","text":"No code only models","x":233,"y":-1174,"width":250,"height":60},
		{"id":"d5ed70e6a9d4430d","type":"text","text":"HVDetFusion","x":233,"y":-1267,"width":250,"height":60,"color":"2"},
		{"id":"ab26df93c5bc43f6","type":"text","text":"1. Can be used in 3 different methods\n\t1. All camera FOVs\n\t2. Only FV of Camera\n\t3. Addition of RADAR\n2.  Camera is used for general detection including depth estimation\n3. Using the camera's detection as prior, noisy radar data is removed and the useful points are fused.","x":440,"y":-1580,"width":488,"height":260},
		{"id":"5b7055c021a87f3c","type":"file","file":"Images/Pasted image 20260323114038.png","x":573,"y":-1845,"width":460,"height":225},
		{"id":"d1b73cd32446abf5","type":"text","text":"MV2D","x":233,"y":-1820,"width":250,"height":60,"color":"2"},
