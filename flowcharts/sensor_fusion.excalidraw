      "opacity": 100,
      "angle": 0,
      "strokeStyle": "solid",
      "baseFontSize": 18,
      "fontFamily": 1,
      "fontWeight": 400,
      "text": "EADF: Force the depth map to respect sharp discontinuities at object edges instead of blurring them.",
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 18,
      "containerId": "rect_1d0200ea15f54141",
      "originalText": "EADF: Force the depth map to respect sharp discontinuities at object edges instead of blurring them.",
      "isDeleted": false,
      "seed": 8069,
      "groupIds": [],
      "frameId": null,
