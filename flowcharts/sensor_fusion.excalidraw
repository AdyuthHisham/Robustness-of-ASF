        }
      ],
      "updated": 1720000000000,
      "link": null,
      "locked": false
    },
    {
      "type": "text",
      "id": "text_ab26df93c5bc43f6",
      "x": 105,
      "y": 465,
      "width": 478,
      "height": 250,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "strokeStyle": "solid",
      "baseFontSize": 18,
      "fontFamily": 1,
      "fontWeight": 400,
      "text": "1. Can be used in 3 different methods\n\t1. All camera FOVs\n\t2. Only FV of Camera\n\t3. Addition of RADAR\n2.  Camera is used for general detection including depth estimation\n3. Using the camera's detection as prior, noisy radar data is removed and the useful points are fused.",
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 18,
      "containerId": "rect_ab26df93c5bc43f6",
      "originalText": "1. Can be used in 3 different methods\n\t1. All camera FOVs\n\t2. Only FV of Camera\n\t3. Addition of RADAR\n2.  Camera is used for general detection including depth estimation\n3. Using the camera's detection as prior, noisy radar data is removed and the useful points are fused.",
      "isDeleted": false,
      "seed": 724,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1720000000000,
