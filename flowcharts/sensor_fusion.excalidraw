    },
    {
      "type": "text",
      "id": "text_f0c2a9f07413882b",
      "x": 705,
      "y": 345,
      "width": 267,
      "height": 188,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "strokeStyle": "solid",
      "baseFontSize": 18,
      "fontFamily": 1,
      "fontWeight": 400,
      "text": "Depth Jump: When a camera-only model tries to predict depth for every pixel in an image (the first step of LSS), it often makes sudden, incorrect jumps exactly at the edges of objects.",
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 18,
      "containerId": "rect_f0c2a9f07413882b",
      "originalText": "Depth Jump: When a camera-only model tries to predict depth for every pixel in an image (the first step of LSS), it often makes sudden, incorrect jumps exactly at the edges of objects.",
      "isDeleted": false,
      "seed": 6454,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1720000000000,
      "link": null,
      "locked": false
    },
    {
      "type": "rectangle",
      "id": "rect_ab26df93c5bc43f6",
      "x": 100,
      "y": 460,
      "width": 488,
      "height": 260,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "seed": 723,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [
        {
          "id": "text_ab26df93c5bc43f6",
