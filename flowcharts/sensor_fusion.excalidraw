      "strokeStyle": "solid",
      "baseFontSize": 18,
      "fontFamily": 1,
      "fontWeight": 400,
      "text": "1. Adds EADF and FDG as additions to LSS for improving loss calculation; for solving Depth Jump.",
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 18,
      "containerId": "rect_dae158106eb5cc47",
      "originalText": "1. Adds EADF and FDG as additions to LSS for improving loss calculation; for solving Depth Jump.",
