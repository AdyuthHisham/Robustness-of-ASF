        }
      ],
      "updated": 1720000000000,
      "link": null,
      "locked": false
    },
    {
      "type": "text",
      "id": "text_1417ad984497c2b4",
      "x": 705,
      "y": 105,
      "width": 505,
      "height": 230,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "strokeStyle": "solid",
      "baseFontSize": 18,
      "fontFamily": 1,
      "fontWeight": 400,
      "text": "1. Individual backbones and detection heads for camera and lidar where feature maps and bounding boxes are generated.\n2. Using these queries are generated which is fed to an encoder.\n3. Self-attention and cross-attention for generating *detections*. (Not BEV Maps but BEV maps can be inferred)\n4. It is faster than BEVFusion during inference",
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 18,
      "containerId": "rect_1417ad984497c2b4",
      "originalText": "1. Individual backbones and detection heads for camera and lidar where feature maps and bounding boxes are generated.\n2. Using these queries are generated which is fed to an encoder.\n3. Self-attention and cross-attention for generating *detections*. (Not BEV Maps but BEV maps can be inferred)\n4. It is faster than BEVFusion during inference",
      "isDeleted": false,
      "seed": 8551,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1720000000000,
