    {
      "type": "text",
      "id": "text_2d0a7b3c08170a41",
      "x": 705,
      "y": 945,
      "width": 422,
      "height": 164,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
